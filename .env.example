# Copiar este archivo como .env (no se sube a git) y cambiar los valores.

# Credenciales de MySQL (se usan para las tres bases de datos, cada una en su propio contenedor)
DB_USER=mpaz
DB_PASSWORD=cambiar_esta_clave
DB_ROOT_PASSWORD=cambiar_esta_clave_root

# Clave para firmar los tokens JWT (HMAC-SHA256, minimo 32 caracteres)
JWT_SECRET=cambiar-por-una-clave-larga-de-al-menos-32-caracteres
